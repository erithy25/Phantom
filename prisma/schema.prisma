generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  hashedPassword  String?
  image           String?
  emailVerified   DateTime?
  role            String    @default("USER")
  universityId    String?
  onboardingDone  Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  university    University?     @relation(fields: [universityId], references: [id])
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  courses       Course[]
  assignments   Assignment[]
  drafts        Draft[]
  lectures      Lecture[]
  flashcards    Flashcard[]
  conversations Conversation[]
  notifications Notification[]
  activities    Activity[]
  gpaHistory    GpaHistory[]
  gpaScenarios  GpaScenario[]
  settings      UserSettings?
  lmsConnections LmsConnection[]

  @@index([universityId])
  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  deviceType   String?
  ipAddress    String?
  lastActive   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id         String   @id @default(cuid())
  email      String
  code       String
  expires    DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([email])
  @@index([code])
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@index([token])
}

// ============================================
// UNIVERSITY & LMS
// ============================================

model University {
  id          String   @id @default(cuid())
  name        String
  domain      String   @unique
  lmsType     String?
  lmsUrl      String?
  logoUrl     String?
  studentCount Int     @default(0)
  createdAt   DateTime @default(now())

  users            User[]
  campusPulseStats CampusPulse[]
  professorProfiles ProfessorProfile[]
}

model LmsConnection {
  id           String   @id @default(cuid())
  userId       String
  lmsType      String
  accessToken  String?  @db.Text
  refreshToken String?  @db.Text
  lmsUrl       String?
  status       String   @default("CONNECTED")
  lastSyncAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// COURSES & ACADEMICS
// ============================================

model Course {
  id             String   @id @default(cuid())
  userId         String
  lmsCourseId    String?
  name           String
  code           String
  professorName  String?
  credits        Float    @default(3)
  semester       String?
  currentGrade   Float?
  letterGrade    String?
  isActive       Boolean  @default(true)
  syllabusText   String?  @db.Text
  semesterProgress Float  @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  lectures          Lecture[]
  flashcards        Flashcard[]
  professorProfile  ProfessorProfile?
  coursePulseStats  CoursePulse[]

  @@index([userId])
  @@index([semester])
}

model ProfessorProfile {
  id               String   @id @default(cuid())
  courseId          String   @unique
  universityId     String?
  name             String
  styleModel       Json?
  gradingPatterns  Json?
  preferences      Json?
  emphasisTopics   Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  university University? @relation(fields: [universityId], references: [id])

  @@index([universityId])
}

model Assignment {
  id            String    @id @default(cuid())
  courseId       String
  userId         String
  lmsAssignmentId String?
  title          String
  description    String?  @db.Text
  dueDate        DateTime?
  weight         Float?
  maxScore       Float?
  grade          Float?
  status         String   @default("NOT_STARTED")
  priority       String   @default("MEDIUM")
  estimatedTime  Int?
  gpaImpact      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  drafts Draft[]

  @@index([courseId])
  @@index([userId])
  @@index([dueDate])
  @@index([status])
}

// ============================================
// DRAFTS (DRAFT FACTORY)
// ============================================

model Draft {
  id             String   @id @default(cuid())
  assignmentId   String
  userId         String
  content        String   @db.Text
  predictedGrade String?
  confidenceAreas Json?
  phantomNotes   Json?
  version        Int      @default(1)
  status         String   @default("GENERATED")
  wordCount      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([userId])
}

// ============================================
// LECTURES (LECTURE GHOST)
// ============================================

model Lecture {
  id              String    @id @default(cuid())
  courseId         String
  userId           String
  title            String?
  date             DateTime  @default(now())
  audioUrl         String?
  transcript       String?   @db.Text
  summary          String?   @db.Text
  durationSeconds  Int?
  topics           Json?
  captureMethod    String?
  processingStatus String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
  examQuestions ExamQuestion[]

  @@index([courseId])
  @@index([userId])
  @@index([date])
}

model Flashcard {
  id           String    @id @default(cuid())
  lectureId    String?
  courseId      String?
  userId        String
  question      String    @db.Text
  answer        String    @db.Text
  difficulty    String    @default("MEDIUM")
  lastReviewed  DateTime?
  nextReview    DateTime?
  createdAt     DateTime  @default(now())

  lecture Lecture? @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([lectureId])
  @@index([courseId])
  @@index([userId])
}

model ExamQuestion {
  id          String   @id @default(cuid())
  lectureId   String
  question    String   @db.Text
  answer      String?  @db.Text
  topic       String?
  confidence  Float?
  createdAt   DateTime @default(now())

  lecture Lecture @relation(fields: [lectureId], references: [id], onDelete: Cascade)

  @@index([lectureId])
}

// ============================================
// AI CHAT
// ============================================

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  isPinned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId])
  @@index([updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String   @db.Text
  richContent    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

// ============================================
// GPA OPTIMIZATION
// ============================================

model GpaHistory {
  id        String   @id @default(cuid())
  userId    String
  semester  String
  gpa       Float
  credits   Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, semester])
}

model GpaScenario {
  id          String   @id @default(cuid())
  userId      String
  name        String
  courseGrades Json
  resultGpa   Float
  probability Float?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ============================================
// CAMPUS PULSE (SOCIAL)
// ============================================

model CampusPulse {
  id            String   @id @default(cuid())
  universityId  String
  date          DateTime @default(now())
  activeUsers   Int      @default(0)
  totalUsers    Int      @default(0)
  weeklyGrowth  Int      @default(0)
  stats         Json?

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([date])
}

model CoursePulse {
  id            String   @id @default(cuid())
  courseId      String
  phantomUsers  Int      @default(0)
  totalStudents Int      @default(0)
  avgPhantomGrade Float?
  avgNonPhantomGrade Float?
  topActions    Json?
  updatedAt     DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// ============================================
// SUBSCRIPTION / BILLING
// ============================================

model Subscription {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  plan                   String    @default("FREE")
  status                 String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([plan])
  @@index([status])
}

// ============================================
// USER SETTINGS
// ============================================

model UserSettings {
  id                    String  @id @default(cuid())
  userId                String  @unique
  theme                 String  @default("dark")
  language              String  @default("en")
  writingTone           String  @default("BALANCED")
  draftAutonomy         String  @default("BALANCED")
  gpaAdvisorLevel       String  @default("ACTIVE")
  notificationAlerts    Boolean @default(true)
  notificationDrafts    Boolean @default(true)
  notificationInsights  Boolean @default(true)
  notificationLectures  Boolean @default(true)
  notificationSocial    Boolean @default(true)
  pushAlerts            Boolean @default(true)
  pushDrafts            Boolean @default(true)
  pushInsights          Boolean @default(false)
  pushSocial            Boolean @default(false)
  quietHoursStart       String?
  quietHoursEnd         String?
  doNotDisturb          Boolean @default(false)
  examMode              Boolean @default(false)
  campusPulseOptIn      Boolean @default(true)
  leaderboardOptIn      Boolean @default(false)
  aiTrainingOptIn       Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// ACTIVITY LOG
// ============================================

model Activity {
  id        String   @id @default(cuid())
  userId    String?
  type      String
  message   String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([type])
}
